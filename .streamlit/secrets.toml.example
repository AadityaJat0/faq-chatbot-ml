# Copy this file to .streamlit/secrets.toml for local development, and paste
# the same contents into Streamlit Cloud -> your app -> Settings -> Secrets.
#
# NEVER commit .streamlit/secrets.toml. Only this .example file belongs in git.

[supabase]
# Project URL from Supabase -> Project Settings -> API
url = "https://YOUR-PROJECT-REF.supabase.co"
# Service-role key from Supabase -> Project Settings -> API -> service_role.
# This key bypasses Row Level Security, so it must stay server-side only:
# never in the repository, never in client-side code, never in a screenshot.
service_role_key = "PASTE-YOUR-SERVICE-ROLE-KEY-HERE"

[owner]
# Password for the owner-only suggestion review page at /Owner_Review.
# Choose a long random string; it is the only thing standing between the
# public internet and the Approve/Reject buttons.
review_password = "PASTE-A-LONG-RANDOM-PASSWORD-HERE"
